# Shopify Headless sales channel credentials. Keep the private token server-side.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_xxx
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Resend contact form. The sender must use a domain verified in Resend.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Auto Deko <kontakt@your-domain.de>
CONTACT_TO_EMAIL=kontakt@your-domain.de

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx
